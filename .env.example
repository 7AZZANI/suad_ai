# =============================================================================
# Suad AI — AI Voice Agent Platform
# Copy this file to `.env` and adjust. Every value has a safe local default.
# Nothing here requires a cloud account to boot the platform.
#
# IMPORTANT: dotenv does NOT strip inline comments. Keep comments on their own
# lines (like this), never after `KEY=value`.
# =============================================================================

# ---- App -------------------------------------------------------------------
APP_NAME=Suad AI
# APP_ENV: local | staging | production
APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production-please-32-chars-min
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- LLM -------------------------------------------------------------------
# Default: local Ollama (OpenAI-compatible API). No key required.
# LLM_PROVIDER: ollama | vllm | lmstudio | openrouter | openai | dashscope | anthropic
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=local
LLM_MODEL=qwen3:4b
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=60

# --- OpenRouter -------------------------------------------------------------
# LLM_PROVIDER=openrouter
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=
# LLM_MODEL=qwen/qwen3-32b

# --- OpenAI -----------------------------------------------------------------
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=gpt-4.1-mini

# --- Alibaba DashScope (OpenAI-compatible) ----------------------------------
# LLM_PROVIDER=dashscope
# LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# LLM_API_KEY=
# LLM_MODEL=qwen-plus

# --- Anthropic Claude -------------------------------------------------------
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-4
ANTHROPIC_API_KEY=

# ---- Speech-to-Text (STT) --------------------------------------------------
# Default: local faster-whisper. No key required.
# STT_PROVIDER: faster_whisper | null
STT_PROVIDER=faster_whisper
# STT_MODEL: tiny | base | small | medium | large-v3
STT_MODEL=large-v3
# STT_DEVICE: auto | cpu | cuda
STT_DEVICE=auto
# STT_COMPUTE_TYPE: int8 | float16 | float32
STT_COMPUTE_TYPE=int8
# Leave blank to autodetect language.
STT_LANGUAGE=

# ---- Text-to-Speech (TTS) --------------------------------------------------
# Default: local Piper. No key required.
# TTS_PROVIDER: piper | xtts | null
TTS_PROVIDER=piper
# Path to a Piper .onnx voice model. Blank = offline tone fallback.
TTS_VOICE=
TTS_PIPER_BINARY=piper
XTTS_MODEL=tts_models/multilingual/multi-dataset/xtts_v2

# ---- Telephony -------------------------------------------------------------
# Default: local-first LiveKit / SIP. Placeholder until credentials are set.
# TELEPHONY_PROVIDER: livekit_sip | twilio | null
TELEPHONY_PROVIDER=livekit_sip
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Optional Twilio --------------------------------------------------------
# TELEPHONY_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ---- Memory / RAG ----------------------------------------------------------
# RAG is OPTIONAL. RAG_ENABLED=false makes the agent skip retrieval entirely.
RAG_ENABLED=true
# MEMORY_PROVIDER: qdrant | null
MEMORY_PROVIDER=qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=suad_knowledge
# Embeddings reuse an OpenAI-compatible endpoint (Ollama by default).
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_API_KEY=local
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768

# ---- Database & Services ---------------------------------------------------
# Production default (Docker Compose / local Postgres):
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/voice_agent
# Zero-dependency local boot (no Postgres needed) — uncomment instead:
# DATABASE_URL=sqlite+aiosqlite:///./data/suad.db
REDIS_URL=redis://localhost:6379/0

# ---- Permissions -----------------------------------------------------------
# Role applied to callers with no explicit identity.
DEFAULT_ROLE=operator
# Auto-approve "approval"-tier actions. DANGEROUS — dev only.
AUTO_APPROVE_RISKY_ACTIONS=false
